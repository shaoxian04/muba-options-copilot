{
  "name": "muba-copilot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "explore": "npm run explore -w @copilot/api",
    "fill": "npm run fill -w @copilot/api",
    "forecast": "npm run forecast -w @copilot/api",
    "wallet": "npm run wallet -w @copilot/api",
    "dev": "npm run dev -w @copilot/api",
    "test": "npm run test -w @copilot/shared && npm run test -w @copilot/api",
    "prototype": "node -e \"require('child_process').exec((process.platform==='win32'?'start \\\"\\\" ':'open ')+'apps/web/prototype-copilot.html')\""
  }
}
