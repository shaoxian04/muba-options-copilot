# --- Chain -------------------------------------------------------------
# alchemy.com -> create app -> Base Mainnet. Do NOT use https://mainnet.base.org
THETANUTS_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Disposable wallet only. `thetanuts wallet create` stores this at
# ~/.config/thetanuts/config.json (chmod 0600) - you only need it here for the app.
THETANUTS_PRIVATE_KEY=

# --- AI ----------------------------------------------------------------
# All three power the Forecast analysis endpoints (news sentiment / price prediction /
# risk-benefit) -- read-only, never touches money. Tried in order -- OpenAI, then Groq,
# then Claude -- each used when the tier before it has no key set or its call fails.
# platform.openai.com -> API keys
OPENAI_API_KEY=
# console.groq.com -> API keys
GROQ_API_KEY=
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# --- News sources -------------------------------------------------------
# Optional. Without these, /news/crypto falls back to live RSS then
# CryptoCompare, and /news/macro falls back straight to the same RSS/
# CryptoCompare chain -- both work with zero keys configured.
# cryptopanic.com/developers/api
CRYPTOPANIC_API_KEY=
# gnews.io
GNEWS_API_KEY=
# newsapi.org
NEWS_API_KEY=

# --- Agents service (ADR-0007) -----------------------------------------
# The Python service at apps/agents. Loopback only. Read-only today: it serves
# technical indicators to the Forecast surface and never touches money.
#   cd apps/agents && .venv/Scripts/python server.py
AGENTS_ENDPOINT=http://127.0.0.1:8000

# --- News Sources ------------------------------------------------------
# Optional: CryptoPanic developer auth token (cryptopanic.com/developers/api)
CRYPTOPANIC_API_KEY=
# Optional: GNews API token (gnews.io) or NewsAPI key (newsapi.org) for macro news
GNEWS_API_KEY=
NEWS_API_KEY=

# --- Database (conversation only - see ADR-0003) -----------------------
# Project Settings -> API. SUPABASE_URL is the bare project URL, e.g.
# https://<ref>.supabase.co -- the dashboard's REST endpoint field shows
# "<that>/rest/v1", but the client appends /rest/v1 itself, so drop it. The key
# below is the service_role secret on the same page.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Account system (Supabase Auth, ADR-0014) ---------------------------
# The SAME Supabase project as SUPABASE_URL above -- Auth just needs its public half.
# dashboard.supabase.com -> this project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" public key from that same page -- NOT the service role key. Safe to expose;
# every Supabase frontend ships this in its bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server ------------------------------------------------------------
# Loopback by default. Only change this if you understand that it exposes a
# money-spending endpoint to your network -- set COPILOT_API_TOKEN too if you do.
# Binding to anything other than 127.0.0.1/localhost is REFUSED at startup (process
# exits) unless EXTERNAL_AUTH_IN_FRONT=true below. COPILOT_API_TOKEN does NOT satisfy
# that check by itself: it ships inside the public frontend bundle
# (NEXT_PUBLIC_COPILOT_API_TOKEN) and anyone who loads the site can read it back out
# and replay it directly against this API, from outside the browser and outside CORS.
HOST=127.0.0.1
PORT=3001
# Set to `true` only if a real, non-client-embedded authentication mechanism (a reverse
# proxy that authenticates callers itself, mTLS, a private network with no public
# ingress, etc.) is genuinely in front of this process. This is the only thing that
# lifts the non-loopback startup refusal above -- COPILOT_API_TOKEN alone never does.
EXTERNAL_AUTH_IN_FRONT=
ALLOWED_ORIGIN=http://localhost:3000
# The URL a client (frontend, script) should use to reach this backend -- may differ
# from HOST/PORT above once this sits behind a reverse proxy or gets deployed. Local
# dev address for now.
BACKEND_ENDPOINT=http://127.0.0.1:3001
# Required on /fill, /propose, and /forecast/* whenever set -- not just /fill. The
# frontend sends it as `Authorization: Bearer ...`. /propose and /forecast/* are also
# rate-limited (30/min per IP) regardless of whether this is set, since they cost real
# Thetanuts/AI API usage even though they never move funds.
# The four /forecast/* GET routes (news, price, risk-benefit, indicators) are the one
# exception: they refuse with 503 if this is left unset, rather than running open. A
# plain GET is forgeable cross-site even from a disallowed CORS origin, and each one
# triggers a real, billed AI/CoinGecko call.
COPILOT_API_TOKEN=
# The SAME value again, for the browser. Next.js only inlines NEXT_PUBLIC_* into the
# bundle, so without this the surface has no token to send and Confirm answers 401.
# It is not a secret from the person at the browser -- the wallet is theirs. It defends
# against a page on another origin POSTing to loopback, and that page cannot read this
# bundle because of the CORS allowlist.
NEXT_PUBLIC_COPILOT_API_TOKEN=
# Where the surface looks for the API. Defaults to the loopback address above.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001

# --- Multi-wallet connector -----------------------------------------------
# Free project ID from cloud.reown.com (formerly WalletConnect Cloud). Only needed for
# the "WalletConnect" option in the wallet picker (phone wallets); browser-extension
# wallets never use it. Safe to leave empty in dev -- picking WalletConnect with none
# set fails at connect time with a clear error, nothing crashes at build or page load.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Agents ------------------------------------------------------------
# The Review Agent is a Python service that does not exist yet, so it is stubbed as
# always-agreeing. Set this to `veto` to force a Veto and build the halt state against
# it. It can only ever BLOCK a trade -- the Review Agent may not authorise (ADR-0006).
COPILOT_REVIEW_FIXTURE=

# --- Safety ------------------------------------------------------------
# Hard ceiling in USDC on any single fill, enforced in code.
MAX_FILL_USDC=2

# What a new session's Risk Budget starts at, in USDC. One ceiling for the whole wallet:
# a Cover Request's Reserve Price counts against it exactly as a Fill's Max Loss does
# (CONTEXT-MAP), so it has to be at least the Cover premium cap of 8 or Cover is refused
# before a Borrower has done anything wrong. Default 10.
DEFAULT_RISK_BUDGET_USDC=10
