# --- Chain -------------------------------------------------------------
# alchemy.com -> create app -> Base Mainnet. Do NOT use https://mainnet.base.org
THETANUTS_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Disposable wallet only. `thetanuts wallet create` stores this at
# ~/.config/thetanuts/config.json (chmod 0600) - you only need it here for the app.
THETANUTS_PRIVATE_KEY=

# --- AI ----------------------------------------------------------------
# All three power the Forecast analysis endpoints (news sentiment / price prediction /
# risk-benefit) -- read-only, never touches money. Tried in order -- OpenAI, then Groq,
# then Claude -- each used when the tier before it has no key set or its call fails.
# platform.openai.com -> API keys
OPENAI_API_KEY=
# console.groq.com -> API keys
GROQ_API_KEY=
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# --- News Sources ------------------------------------------------------
# Optional: CryptoPanic developer auth token (cryptopanic.com/developers/api)
CRYPTOPANIC_API_KEY=
# Optional: GNews API token (gnews.io) or NewsAPI key (newsapi.org) for macro news
GNEWS_API_KEY=
NEWS_API_KEY=

# --- Database (conversation only - see ADR-0003) -----------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Server ------------------------------------------------------------
# Loopback by default. Only change this if you understand that it exposes a
# money-spending endpoint to your network -- set COPILOT_API_TOKEN too if you do.
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000
# The URL a client (frontend, script) should use to reach this backend -- may differ
# from HOST/PORT above once this sits behind a reverse proxy or gets deployed. Local
# dev address for now.
BACKEND_ENDPOINT=http://127.0.0.1:3001
# Required on /fill, /propose, and /forecast/* whenever set -- not just /fill. The
# frontend sends it as `Authorization: Bearer ...`. /propose and /forecast/* are also
# rate-limited (30/min per IP) regardless of whether this is set, since they cost real
# Thetanuts/AI API usage even though they never move funds.
COPILOT_API_TOKEN=
# The SAME value again, for the browser. Next.js only inlines NEXT_PUBLIC_* into the
# bundle, so without this the surface has no token to send and Confirm answers 401.
# It is not a secret from the person at the browser -- the wallet is theirs. It defends
# against a page on another origin POSTing to loopback, and that page cannot read this
# bundle because of the CORS allowlist.
NEXT_PUBLIC_COPILOT_API_TOKEN=
# Where the surface looks for the API. Defaults to the loopback address above.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001

# --- Agents ------------------------------------------------------------
# The Review Agent is a Python service that does not exist yet, so it is stubbed as
# always-agreeing. Set this to `veto` to force a Veto and build the halt state against
# it. It can only ever BLOCK a trade -- the Review Agent may not authorise (ADR-0006).
COPILOT_REVIEW_FIXTURE=

# --- Safety ------------------------------------------------------------
# Hard ceiling in USDC on any single fill, enforced in code.
MAX_FILL_USDC=2
